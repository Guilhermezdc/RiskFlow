<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN">
    <Appenders>

        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout pattern="%d{HH:mm:ss.SSS} [%t] %-5level %logger{36} — %msg%n"/>
        </Console>

        <RollingFile name="RollingFile"
                     fileName="logs/risk-flow.log"
                     filePattern="logs/risk-flow-%d{yyyy-MM-dd}-%i.log.gz">
            <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss.SSS} [%t] %-5level %logger{36} — %msg%n"/>
            <Policies>
                <TimeBasedTriggeringPolicy interval="1" modulate="true"/>
                <SizeBasedTriggeringPolicy size="100 MB"/>
            </Policies>
            <DefaultRolloverStrategy max="7"/>
        </RollingFile>

    </Appenders>

    <Loggers>
        <!-- Reduz verbosidade de libs externas -->
        <Logger name="org.apache.flink"      level="INFO"  additivity="false">
            <AppenderRef ref="Console"/>
        </Logger>
        <Logger name="org.apache.kafka"      level="WARN"  additivity="false">
            <AppenderRef ref="Console"/>
        </Logger>
        <Logger name="com.datastax"          level="WARN"  additivity="false">
            <AppenderRef ref="Console"/>
        </Logger>
        <Logger name="redis.clients"         level="WARN"  additivity="false">
            <AppenderRef ref="Console"/>
        </Logger>

        <!-- Aplicação — DEBUG em desenvolvimento, INFO em produção -->
        <Logger name="com.riskflow"          level="DEBUG" additivity="false">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="RollingFile"/>
        </Logger>

        <Root level="INFO">
            <AppenderRef ref="Console"/>
        </Root>
    </Loggers>
</Configuration>
